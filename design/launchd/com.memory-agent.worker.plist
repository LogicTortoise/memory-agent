<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase C launchd template — NOT installed by this revision.

  The macOS launchd integration is **opt-in**. To enable it:

    1. Edit the placeholders below:
         - <VAULT_PATH>        absolute path to the memory-agent vault
         - <WORKER_ID>         a stable worker identifier (defaults to 'worker_local')
         - <PYTHON_BIN>        absolute path to the Python interpreter that
                               runs `python -m memory_agent`
         - <LOG_STDIO> / <LOG_STDIO_ERR>
                               paths to log files the worker can append to.
    2. Copy this file to ~/Library/LaunchAgents/com.memory-agent.worker.plist
       or /Library/LaunchDaemons/com.memory-agent.worker.plist.
    3. `launchctl load -w ~/Library/LaunchAgents/com.memory-agent.worker.plist`.

  The plist only starts / restarts the worker process; it does NOT
  drive the schedule. The worker honours the project-owned
  `worker_schedule.json` file (default: <vault>/config/worker_schedule.json)
  plus the integrated source-correction queue (Phase C). It will not
  fire any model unless the scanner found new bytes / batches are
  ready / a correction proposal needs scanning.

  This template is intentionally minimal — it does NOT install launchd
  in the repository, and it does NOT enable launchd on first run.
  Removal: `launchctl unload -w ~/Library/LaunchAgents/com.memory-agent.worker.plist`.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.memory-agent.worker</string>

    <!-- The worker itself owns timing; launchd only restarts the
         process when it dies. RunAtLoad keeps it alive after boot. -->
    <key>ProgramArguments</key>
    <array>
        <string><PYTHON_BIN></string>
        <string>-m</string>
        <string>memory_agent</string>
        <string>--vault</string>
        <string><VAULT_PATH></string>
        <string>worker</string>
        <string>--worker-id</string>
        <string><WORKER_ID></string>
        <string>--lease-ttl</string>
        <string>30</string>
        <string>--schedule</string>
        <string><VAULT_PATH>/config/worker_schedule.json</string>
        <string>--stop-file</string>
        <string><VAULT_PATH>/worker.stop</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string><SOURCE_ROOT>/src</string>
        <key>MEMORY_AGENT_WORKER_ID</key>
        <string><WORKER_ID></string>
    </dict>

    <key>WorkingDirectory</key>
    <string><SOURCE_ROOT></string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <!-- Only restart on crash / SIGTERM; never on idle exit. The
             worker decides when it is done; we want launchd to keep
             the process alive across crashes. -->
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string><LOG_STDIO></string>
    <key>StandardErrorPath</key>
    <string><LOG_STDIO_ERR></string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
    </dict>
</dict>
</plist>